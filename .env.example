# Copy to .env (git-ignored). Phase 2 (mock-only) needs none of these.
# Data directory (default: ./data) and reports directory (default: ./reports)
MIA_DATA_DIR=
MIA_REPORTS_DIR=
# Override the read-only Punyamas workspace root (default from config/research-sources.yaml)
MIA_WORKSPACE_ROOT=
# Provider name: mock (only value available in Phase 2)
MIA_PROVIDER=mock
# Mock fixture key override (default: name of the inputs directory)
MIA_FIXTURE_KEY=
# Reserved for Phase 3+ (not used; no paid calls are made in Phase 2)
ANTHROPIC_API_KEY=
